# Copia este archivo como .env (nunca se sube al repo).
# Sin credenciales, The Brain funciona en modo simulado (router por palabras clave y agentes de demo).

# Opción recomendada: tu suscripción de Claude (Pro/Max), para uso personal en tu equipo.
# Ejecuta "npm run login", inicia sesión en el navegador y pega aquí el token que te da.
CLAUDE_CODE_OAUTH_TOKEN=

# Alternativa: una API key de pago por uso (https://console.anthropic.com).
# ANTHROPIC_API_KEY=

# Puerto del servidor de agentes (la web en :5173 le hace proxy)
SERVER_PORT=8787
